AI_GATEWAY_ROUTING_STRATEGY="COST_OPTIMIZED" # ACCURACY_FIRST, COST_OPTIMIZED, LOWEST_LATENCY, BALANCED
AI_GATEWAY_MAX_RETRIES=3

# External Platform OAuth & API Keys
