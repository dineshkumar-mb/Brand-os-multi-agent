# Database & Cache
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal_brand_os?schema=public"
REDIS_URL="redis://localhost:6379"

# Vector Memory & Knowledge Graph
CHROMADB_URL="http://localhost:8000"
